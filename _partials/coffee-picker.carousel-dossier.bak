<!-- ═══ NoFilter coffee picker — RESTORED carousel + two-beat dossier (tested) ══════════════
     (a)-restore: carousel row (tiles slide/squeeze) → tap "Details" wedges a compact colour card
     in (squeezing the other coffees to the right) → "Find out more" drops that card DOWN and widens
     it into the full-width dossier. Verbatim of the tested shop picker; the grid quick-buy version
     is backed up at coffee-picker.grid-quickbuy.bak. Relies on host :root tokens. -->
<style id="nf-coffee-picker">
.cx-viewport{position:relative;overflow:hidden;margin:28px auto 4px;min-height:300px;max-width:1000px;}
.cx-track{position:relative;}
.cx-cell{position:absolute;top:0;left:0;width:23.5%;transition:transform .6s cubic-bezier(.5,0,.15,1), opacity .5s ease;will-change:transform,opacity;}
.cx-tile{background:#FBFAF8;border:1.5px solid rgba(26,24,21,.10);border-radius:14px;padding:9px;cursor:pointer;position:relative;display:flex;flex-direction:column;transition:border-color .18s,box-shadow .18s;}
.cx-tile:hover{box-shadow:0 10px 24px rgba(26,24,21,.09);}
.cx-tile.is-picked{border-color:var(--or,#ed3326);}
.cx-tile.is-active{border-color:var(--nb,#1A1815);}
.cx-bar{height:4px;border-radius:99px;margin:2px 3px 8px;}
.cx-photo{aspect-ratio:3/4;border-radius:8px;overflow:hidden;background:#efe9df;position:relative;}
.cx-photo img{width:100%;height:100%;object-fit:cover;object-position:center 42%;display:block;}
.cx-name{font-family:var(--font-d,Georgia,serif);font-size:15px;margin:8px 3px 6px;color:var(--nb,#1A1815);}
.cx-note{font-family:var(--font-m,monospace);font-size:8.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--gy,#6B6B6B);margin:0 3px 7px;}
.cx-chips{display:flex;gap:5px;flex-wrap:wrap;margin:0 3px 6px;}
.cx-chip{font-family:var(--font-m,monospace);font-size:8.5px;letter-spacing:.03em;text-transform:uppercase;padding:3px 8px;border:1px solid rgba(26,24,21,.16);border-radius:99px;color:rgba(26,24,21,.62);}
.cx-scales{display:flex;flex-direction:column;gap:3px;margin:0 3px 8px;}
.cx-scale{display:flex;align-items:center;justify-content:space-between;}
.cx-scale-lab{font-family:var(--font-m,monospace);font-size:8.5px;letter-spacing:.08em;text-transform:uppercase;color:rgba(26,24,21,.5);}
.cx-dots{display:inline-flex;align-items:center;}
.cx-dot{width:7px;height:7px;border-radius:50%;border:1.5px solid rgba(26,24,21,.3);display:inline-block;margin-left:4px;box-sizing:border-box;}
.cx-dot.on{background:var(--nb,#1A1815);border-color:var(--nb,#1A1815);}
.cx-tick{position:absolute;top:13px;right:13px;width:23px;height:23px;border-radius:50%;background:var(--or,#ed3326);color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;z-index:3;transform:scale(0);transition:transform .22s cubic-bezier(.34,1.6,.64,1);}
.cx-tile.is-picked .cx-tick{transform:scale(1);}
.cx-foot{display:flex;align-items:center;justify-content:space-between;gap:6px;margin:auto 3px 0;}
.cx-status{font-family:var(--font-m,monospace);font-size:9px;letter-spacing:.05em;text-transform:uppercase;color:var(--gy,#6B6B6B);}
.cx-tile.is-picked .cx-status{color:var(--or,#ed3326);}
.cx-details{font-family:var(--font-m,monospace);font-size:9px;letter-spacing:.05em;text-transform:uppercase;color:var(--nb,#1A1815);background:none;border:none;border-bottom:1px solid rgba(26,24,21,.3);cursor:pointer;padding:1px 0;}
.cx-details:hover{color:var(--or,#ed3326);border-color:var(--or,#ed3326);}
.cx-detailcard{border-radius:14px;padding:16px;color:#F4F2EE;height:100%;display:flex;flex-direction:column;overflow:hidden;position:relative;}
.cx-dc-close{position:absolute;top:11px;right:13px;font-size:15px;background:none;border:none;color:currentColor;cursor:pointer;opacity:.7;z-index:2;}
.cx-dc-close:hover{opacity:1;}
.cx-dc-eyebrow{font-family:var(--font-m,monospace);font-size:8.5px;letter-spacing:.12em;text-transform:uppercase;opacity:.8;margin:0 0 3px;}
.cx-dc-name{font-family:var(--font-d,Georgia,serif);font-size:20px;line-height:1;margin:0 0 3px;}
.cx-dc-region{font-family:var(--font-m,monospace);font-size:8.5px;letter-spacing:.05em;text-transform:uppercase;opacity:.75;margin:0 0 9px;}
.cx-dc-desc{font-size:11px;line-height:1.5;opacity:.95;margin:0 0 10px;}
.cx-dc-notes{display:flex;flex-wrap:wrap;gap:5px;margin:0 0 12px;}
.cx-dc-chip{font-family:var(--font-m,monospace);font-size:8.5px;letter-spacing:.03em;text-transform:uppercase;padding:4px 9px;border-radius:99px;border:1.2px solid currentColor;}
.cx-dc-more{font-family:var(--font-m,monospace);font-size:9px;letter-spacing:.06em;text-transform:uppercase;
  background:none;border:1px solid rgba(244,242,238,.5);border-radius:7px;color:#F4F2EE;padding:8px 12px;
  cursor:pointer;margin-bottom:8px;transition:background .15s;}
.cx-dc-more:hover{background:rgba(244,242,238,.16);}
.cx-dc-add{font-family:var(--font-b,sans-serif);font-size:12px;font-weight:600;border:none;border-radius:8px;padding:10px 16px;cursor:pointer;margin-top:auto;transition:transform .1s,filter .15s;}
.cx-dc-add:hover{filter:brightness(.94);}.cx-dc-add:active{transform:scale(.98);}
.cx-hint{font-family:var(--font-m,monospace);font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--gy,#6B6B6B);text-align:center;margin:14px 0 0;}
.cx-hint.is-warn{color:var(--or,#ed3326);}
/* ── origin dossier — full-width accordion that expands below the row ── */
.cx-dossier{max-height:0;overflow:hidden;border-radius:18px;margin:0 auto;max-width:1460px;color:#F4F2EE;
  transition:max-height .55s cubic-bezier(.5,0,.15,1),margin-top .5s ease;box-shadow:0 30px 70px -30px rgba(26,24,21,.5);}
.cx-dossier.is-open{margin-top:44px;}
.cx-dossier.is-flying{opacity:0;}
/* the only thing that moves: a solid-colour surface that grows from the tapped card */
.cx-morph{position:fixed;z-index:200;border-radius:16px;pointer-events:none;display:none;opacity:0;overflow:hidden;
  box-shadow:0 34px 80px -34px rgba(26,24,21,.55);will-change:left,top,width,height;}
/* content reveals AFTER the colour lands — never scaled, so it can't look cheap */
.cx-db>*{transition:opacity .45s ease, transform .5s cubic-bezier(.4,0,.2,1);}
.cx-db>*:nth-child(1){transition-delay:.04s}.cx-db>*:nth-child(2){transition-delay:.09s}
.cx-db>*:nth-child(3){transition-delay:.14s}.cx-db>*:nth-child(4){transition-delay:.19s}
.cx-db>*:nth-child(5){transition-delay:.24s}.cx-db>*:nth-child(6){transition-delay:.29s}
.cx-db>*:nth-child(7){transition-delay:.34s}
.cx-dv video{transition:opacity .55s ease, clip-path .65s cubic-bezier(.4,0,.2,1);clip-path:inset(0 0 0 0);}
.cx-dv-coord{transition:opacity .5s ease .18s;}
.cx-dossier.is-morphing .cx-db>*{opacity:0;transform:translateY(12px);}
.cx-dossier.is-morphing .cx-dv video{opacity:0;clip-path:inset(0 100% 0 0);}
.cx-dossier.is-morphing .cx-dv-coord{opacity:0;}
.cx-dsheet{position:relative;border-radius:18px;overflow:hidden;}
.cx-sheet-close{position:absolute;top:15px;right:18px;z-index:4;font-family:var(--font-m,monospace);font-size:10px;letter-spacing:.1em;text-transform:uppercase;background:rgba(0,0,0,.24);border:none;border-radius:7px;color:#F4F2EE;padding:8px 12px;cursor:pointer;opacity:.85;transition:opacity .15s,background .15s;}
.cx-sheet-close:hover{opacity:1;background:rgba(0,0,0,.36);}
.cx-drow{display:grid;grid-template-columns:var(--cx-film-col,60%) minmax(0,1fr);align-items:center;gap:0;}
@media(max-width:820px){.cx-drow{grid-template-columns:1fr;}}
.cx-film-frame{padding:var(--cx-frame,22px);}
.cx-dv{position:relative;overflow:hidden;border-radius:12px;background:#0c0c0b;aspect-ratio:var(--cx-film-ar,1.25);box-shadow:0 16px 40px -20px rgba(0,0,0,.55);}
@media(max-width:820px){.cx-dv{aspect-ratio:16/10;}}
.cx-dv video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;}
.cx-dv::after{content:"";position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(200deg,transparent 55%,rgba(0,0,0,.45)),linear-gradient(90deg,transparent 78%,rgba(0,0,0,.28));}
.cx-dv-coord{position:absolute;left:20px;bottom:18px;font-family:var(--font-m,monospace);font-size:10.5px;letter-spacing:.16em;color:#F4F2EE;opacity:.92;text-shadow:0 1px 8px rgba(0,0,0,.6);z-index:2;}
.cx-db{padding:var(--cx-body-pad,40px) var(--cx-body-pad,40px) var(--cx-body-pad,40px) clamp(6px,1vw,14px);align-self:center;}
.cx-db-eyebrow{font-family:var(--font-m,monospace);font-size:10px;letter-spacing:.16em;text-transform:uppercase;opacity:.8;margin:0 0 13px;}
.cx-db-name{font-family:var(--font-display,sans-serif);font-weight:900;text-transform:uppercase;line-height:.9;letter-spacing:-.01em;font-size:clamp(34px,4vw,58px);margin:0 0 15px;}
.cx-db-desc{font-family:var(--font-s,Georgia,serif);font-size:clamp(15px,1.35vw,18px);line-height:1.55;opacity:.94;margin:0 0 20px;max-width:46ch;}
.cx-db-notes{display:flex;flex-wrap:wrap;gap:7px;margin:0 0 22px;}
.cx-db-chip{font-family:var(--font-m,monospace);font-size:9.5px;letter-spacing:.05em;text-transform:uppercase;padding:6px 12px;border-radius:99px;border:1.3px solid rgba(244,242,238,.5);}
.cx-db-buy{margin-top:6px;padding-top:20px;border-top:1px solid rgba(244,242,238,.2);}
.cx-price-row{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:18px;}
.cx-price{font-family:var(--font-display,sans-serif);font-weight:900;font-size:clamp(30px,3.4vw,42px);line-height:.9;color:#F4F2EE;}
.cx-price small{font-family:var(--font-m,monospace);font-size:11px;font-weight:400;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,232,195,.6);display:block;margin-bottom:6px;}
.cx-db-sizes{display:inline-flex;gap:6px;}
.cx-db-size{font-family:var(--font-m,monospace);font-size:10px;letter-spacing:.05em;text-transform:uppercase;
  background:none;border:1.4px solid rgba(244,242,238,.45);border-radius:8px;color:#F4F2EE;padding:9px 13px;cursor:pointer;transition:background .15s,border-color .15s;}
.cx-db-size:hover{border-color:rgba(244,242,238,.8);}
.cx-db-size.is-sel{background:#F4F2EE;color:#1A1815;border-color:#F4F2EE;}
.cx-db-qty{display:inline-flex;align-items:center;gap:12px;border:1.4px solid rgba(244,242,238,.5);border-radius:10px;padding:7px 12px;}
.cx-db-step{width:26px;height:26px;border:none;border-radius:6px;background:rgba(244,242,238,.16);color:#F4F2EE;font-size:16px;line-height:1;cursor:pointer;transition:background .15s;}
.cx-db-step:hover{background:rgba(244,242,238,.3);}
.cx-db-n{font-family:var(--font-m,monospace);font-size:13px;min-width:16px;text-align:center;}
.cx-db-imp2{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;}
.cx-db-imp-left{display:flex;align-items:center;gap:18px;}
.cx-seal{position:relative;width:100px;height:100px;flex:0 0 auto;}
.cx-seal svg{position:absolute;inset:0;width:100%;height:100%;animation:cxSpin 22s linear infinite;}
@keyframes cxSpin{to{transform:rotate(360deg);}}
.cx-seal text{font-family:var(--font-m,monospace);font-size:9px;letter-spacing:2px;fill:rgba(255,232,195,.85);text-transform:uppercase;}
.cx-seal-center{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;}
.cx-seal-pct{font-family:var(--font-display,sans-serif);font-weight:900;font-size:32px;line-height:.8;color:#F4F2EE;}
.cx-seal-pct small{font-size:14px;vertical-align:super;}
.cx-seal-amt{display:flex;flex-direction:column;gap:3px;}
.cx-seal-k{font-family:var(--font-m,monospace);font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,232,195,.5);}
.cx-seal-amt b{font-family:var(--font-display,sans-serif);font-weight:900;font-size:33px;color:#F4F2EE;line-height:.92;letter-spacing:-.01em;}
.cx-seal-to{font-family:var(--font-m,monospace);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:rgba(255,232,195,.7);}
@media(prefers-reduced-motion:reduce){.cx-seal svg{animation:none;}}
.cx-db-add{font-family:var(--font-b,sans-serif);font-size:15px;font-weight:700;color:#fff;background:var(--or,#ed3326);border:none;border-radius:12px;padding:15px 30px;cursor:pointer;display:inline-flex;align-items:center;gap:10px;box-shadow:0 10px 26px rgba(238,77,23,.28);transition:transform .1s,filter .15s;}
.cx-db-add:hover{filter:brightness(1.05);transform:translateY(-1px);}.cx-db-add:active{transform:scale(.98);}
.cx-morelink{display:inline-block;margin-top:20px;font-family:var(--font-m,monospace);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#F4F2EE;border-bottom:1px solid rgba(244,242,238,.5);padding-bottom:2px;text-decoration:none;}
.cx-db-close{font-family:var(--font-m,monospace);font-size:10px;letter-spacing:.1em;text-transform:uppercase;background:none;border:none;color:currentColor;opacity:.7;cursor:pointer;padding:6px 2px;}
.cx-db-close:hover{opacity:1;}
@media(prefers-reduced-motion:reduce){.cx-dossier{transition:opacity .3s ease;}}
</style>

<div class="cx-viewport rv"><div class="cx-track" id="cxTrack" role="group" aria-label="Choose your coffee origins"></div></div>
<div class="cx-dossier" id="cxDossier" aria-hidden="true"></div>
<p id="qOriginHint" class="cx-hint"></p>

<script>
    // ── choose-your-coffees carousel + two-beat dossier (Details wedge → Find out more drop/widen) ──
    (function(){
      var track = document.getElementById('cxTrack');
      var hint = document.getElementById('qOriginHint');
      if(!track) return;
      var vp = track.parentElement;
      var GAP = 14;
      var COFFEES = [
        {name:'Batang Toru', sched:'batang toru', note:'N. SUMATRA · PRCF & SRI', color:'#2f5d3a',
         img:'https://nofilter-shared.netlify.app/bag-batang-toru.png',
         video:'https://nofilter-shared.netlify.app/batang-toru-banner.mp4',
         poster:'https://nofilter-shared.netlify.app/sabar-agroforest.jpg',
         cur:'SGD', sizes:[{lab:'1kg',price:80},{lab:'250g',price:25}],
         desc:'The buffer at the edge of Batang Toru, the only home of the Tapanuli orangutan. Shade-grown, farmers paid to keep the forest edge where it is.',
         notes:['Dark chocolate','Red plum','Cedar'], acid:2, body:4, roast:3, coord:'1°38′18″N · 99°15′56″E', partner:'PRCF · SRI', on:true},
        {name:'Batang Gadis', sched:'batang gadis', note:'N. SUMATRA · SRI', color:'#b8531a',
         img:'https://nofilter-shared.netlify.app/bag-batang-gadis.png',
         video:'https://nofilter-shared.netlify.app/batang-gadis-banner.mp4',
         cur:'SGD', sizes:[{lab:'1kg',price:80},{lab:'250g',price:25}],
         desc:'The frontier of Batang Gadis National Park. Community-led agroforestry holds a hard line against clearing at the park’s edge.',
         notes:['Brown sugar','Orange','Almond'], acid:3, body:3, roast:3, coord:'0°31′50″N · 99°46′28″E', partner:'SRI · Komanja', on:false},
        {name:'Gayo Lues', sched:'gayo lues', note:'ACEH · OIC', color:'#9c7212',
         img:'https://nofilter-shared.netlify.app/bag-gayo-lues.png',
         video:'https://nofilter-shared.netlify.app/gayo-lues-banner.mp4',
         cur:'SGD', sizes:[{lab:'1kg',price:80},{lab:'250g',price:25}],
         desc:'High-grown in Gayo Lues, on the edge of the Leuser Ecosystem, one of the last places elephant, tiger, rhino and orangutan still share ground.',
         notes:['Syrupy','Dried fig','Cinnamon'], acid:3, body:5, roast:3, coord:'3°55′N · 97°25′E', partner:'OIC', on:false},
        {name:'Arakan Mountains', sched:'arakan', note:'MYANMAR · FFM & ACCA', color:'#1f5661',
         img:'https://nofilter-shared.netlify.app/bag-arakan.png',
         video:'https://nofilter-shared.netlify.app/batang-arakan-banner.mp4',
         cur:'SGD', sizes:[{lab:'1kg',price:80},{lab:'250g',price:25}],
         desc:'The Asho Chin highlands, where ACCA and Fauna & Flora Myanmar keep the Mann Wildlife Sanctuary intact.',
         notes:['Grapefruit','Candied nuts','Milk chocolate'], acid:5, body:2, roast:2, coord:'19°48′N · 94°20′30″E', partner:'ACCA · Fauna & Flora', on:false}
      ];
      var openIdx = -1, dossierIdx = -1, cells = [];
      var dossier = document.getElementById('cxDossier');

      function build(){
        track.innerHTML=''; cells=[];
        COFFEES.forEach(function(c,i){
          var el=document.createElement('div'); el.className='cx-cell';
          el.innerHTML='<div class="cx-tile'+(c.on?' is-picked':'')+'" data-origin="'+c.name+'" data-sched="'+c.sched+'" role="checkbox" tabindex="0" aria-checked="'+(c.on?'true':'false')+'">'
            +'<div class="cx-tick">✓</div>'
            +'<div class="cx-bar" style="background:'+c.color+'"></div>'
            +'<div class="cx-photo"><img src="'+c.img+'" alt="'+c.name+'" onerror="this.style.opacity=0"></div>'
            +'<div class="cx-name">'+c.name+'</div>'
            +'<div class="cx-chips">'+c.notes.map(function(n){return '<span class="cx-chip">'+n+'</span>';}).join('')+'</div>'
            +'<div class="cx-scales">'
              +[['Acidity',c.acid],['Body',c.body],['Roast',c.roast]].map(function(r){
                var dots=''; for(var d=1;d<=5;d++) dots+='<span class="cx-dot'+(d<=r[1]?' on':'')+'"></span>';
                return '<div class="cx-scale"><span class="cx-scale-lab">'+r[0]+'</span><span class="cx-dots">'+dots+'</span></div>';
              }).join('')
            +'</div>'
            +'<div class="cx-foot"><span class="cx-status">'+(c.on?'In order':'Tap to add')+'</span>'
            +'<button class="cx-details" type="button">Details</button></div></div>';
          track.appendChild(el); cells.push({el:el,kind:'tile',i:i});
          var tile=el.querySelector('.cx-tile');
          tile.addEventListener('click',function(e){ if(e.target.closest('.cx-details'))return; select(i); });
          tile.addEventListener('keydown',function(e){ if(e.key===' '||e.key==='Enter'){e.preventDefault();select(i);} });
          el.querySelector('.cx-details').addEventListener('click',function(e){ e.stopPropagation(); openIdx===i?closeDetail():openDetail(i); });
        });
        var d=document.createElement('div'); d.className='cx-cell'; d.style.opacity='0'; d.setAttribute('data-detail','1');
        track.appendChild(d); cells.push({el:d,kind:'detail',i:-1});
      }
      function tileW(){ return (vp.clientWidth - GAP*3)/4; }
      function layout(animate){
        if(vp.clientWidth < 60){ requestAnimationFrame(function(){ layout(false); }); return; }
        var w=tileW();
        cells.forEach(function(c){ c.el.style.width=w+'px'; });
        var tileH=0;
        cells.forEach(function(cc){ if(cc.kind==='tile'){ var t=cc.el.querySelector('.cx-tile'); if(t){ t.style.minHeight=''; var th=t.offsetHeight; if(th>tileH)tileH=th; } } });
        if(!tileH || tileH<60){ tileH=Math.round(w*4/3+96); }
        cells.forEach(function(cc){ if(cc.kind==='tile'){ var t=cc.el.querySelector('.cx-tile'); if(t) t.style.minHeight=tileH+'px'; } });
        var detailCell=cells[cells.length-1];
        detailCell.el.style.height=tileH+'px';
        track.style.height=tileH+'px';
        var order=[];
        COFFEES.forEach(function(c,i){ order.push(cells[i]); if(openIdx===i) order.push(detailCell); });
        if(openIdx<0) order.push(detailCell);
        var count=order.length, totalW=count*w+(count-1)*GAP, startX=0;
        var detailPos=order.indexOf(detailCell);
        if(openIdx>=0){
          var detailCenter=detailPos*(w+GAP)+w/2;
          startX=vp.clientWidth/2-detailCenter;
          var minX=vp.clientWidth-totalW;
          startX=Math.max(Math.min(startX,0),Math.min(0,minX));
        } else {
          var tilesW=COFFEES.length*w+(COFFEES.length-1)*GAP;
          startX=Math.max(0,(vp.clientWidth-tilesW)/2);
        }
        order.forEach(function(c,pos){
          var x=startX+pos*(w+GAP);
          var delay=animate?Math.min(Math.abs(pos-detailPos)*35,140):0;
          c.el.style.transition=animate?('transform .6s cubic-bezier(.5,0,.15,1) '+delay+'ms, opacity .5s ease'):'none';
          var scale=(openIdx>=0 && c.kind==='tile')?0.9:1;
          c.el.style.transform='translateX('+x+'px) scale('+scale+')';
          c.el.style.transformOrigin='center center';
          var vis=1;
          if(openIdx>=0){
            var left=x,right=x+w;
            if(right<w*0.5||left>vp.clientWidth-w*0.5) vis=0;
            else if(left<0||right>vp.clientWidth) vis=0.35;
            if(c.kind==='tile') vis=Math.min(vis,0.7);
          }
          c.el.style.opacity=(c.kind==='detail'&&openIdx<0)?0:vis;
          if(!animate){ void c.el.offsetWidth; c.el.style.transition=''; }
        });
      }
      function fillDetail(c){
        var d=cells[cells.length-1].el;
        d.innerHTML='<div class="cx-detailcard" style="background:'+c.color+'">'
          +'<button class="cx-dc-close" type="button">✕</button>'
          +'<p class="cx-dc-eyebrow">Conservation coffee</p>'
          +'<h3 class="cx-dc-name">'+c.name+'</h3>'
          +'<p class="cx-dc-region">'+c.note+'</p>'
          +'<p class="cx-dc-desc">'+c.desc+'</p>'
          +'<div class="cx-dc-notes">'+c.notes.map(function(n){return '<span class="cx-dc-chip">'+n+'</span>';}).join('')+'</div>'
          +(c.video?'<button class="cx-dc-more" type="button">Find out more &rarr;</button>':'')
          +'<button class="cx-dc-add" type="button" style="background:#F4F2EE;color:'+c.color+'">'+(c.on?'✓ In order · remove':'Add to order')+'</button></div>';
        d.querySelector('.cx-dc-close').addEventListener('click',closeDetail);
        var moreBtn=d.querySelector('.cx-dc-more');
        if(moreBtn) moreBtn.addEventListener('click',function(e){ e.stopPropagation(); openDossier(COFFEES.indexOf(c)); });
        d.querySelector('.cx-dc-add').addEventListener('click',function(){
          var btn=d.querySelector('.cx-dc-add');
          if(togglePick(COFFEES.indexOf(c))) fillDetail(c);
          else flashKeep(btn,function(){ fillDetail(c); });
        });
      }
      function refreshTiles(){
        COFFEES.forEach(function(c,i){
          var t=cells[i].el.querySelector('.cx-tile');
          t.classList.toggle('is-picked',c.on);
          t.setAttribute('aria-checked',c.on?'true':'false');
          t.querySelector('.cx-status').textContent=c.on?'In order':'Tap to add';
          t.classList.toggle('is-active',openIdx===i || dossierIdx===i);
        });
      }
      function refreshHint(){
        if(!hint) return;
        var n=COFFEES.filter(function(c){return c.on;}).length;
        if(n===0){ hint.textContent='Pick at least one origin to back.'; hint.classList.add('is-warn'); }
        else { hint.textContent=n+(n===1?' origin selected.':' origins selected.'); hint.classList.remove('is-warn'); }
      }
      function togglePick(i){
        var c=COFFEES[i];
        if(c.on && COFFEES.filter(function(x){return x.on;}).length<=1) return false;
        c.on=!c.on; refreshTiles(); refreshHint();
        return true;
      }
      function flashKeep(el,restore){
        if(!el) return; el.textContent='Keep at least one origin';
        clearTimeout(el.__ft); el.__ft=setTimeout(restore,1200);
      }
      function select(i){
        if(!togglePick(i)){
          var st=cells[i].el.querySelector('.cx-status');
          flashKeep(st,function(){ st.textContent='In order'; });
        }
      }
      function openDetail(i){ if(dossierIdx>=0) closeDossier(); openIdx=i; fillDetail(COFFEES[i]); refreshTiles(); layout(true); }
      function closeDetail(){ openIdx=-1; refreshTiles(); layout(true); }

      var morphT, morph;
      function ensureMorph(){ if(!morph){ morph=document.createElement('div'); morph.className='cx-morph'; document.body.appendChild(morph); } return morph; }
      function syncDossierHeight(){ if(dossierIdx>=0 && dossier){ dossier.style.transition='none'; dossier.style.maxHeight=dossier.scrollHeight+'px'; void dossier.offsetWidth; dossier.style.transition=''; } }
      function fmtAmt(v){ return (Math.round(v*100)%100===0)? String(Math.round(v)) : v.toFixed(2); }
      function cxCountUp(el,to,dur){ var from=parseFloat(el.textContent)||0,s=performance.now(); (function st(t){ t=t||performance.now(); var p=Math.min(1,(t-s)/dur),e=1-Math.pow(1-p,3); el.textContent=fmtAmt(from+(to-from)*e); if(p<1)requestAnimationFrame(st); })(); }
      function buildDossier(c,i){
        var sizes=c.sizes||[]; var cur=c.cur||'SGD';
        var sizePills = sizes.map(function(s,si){ return '<button class="cx-db-size'+(si===0?' is-sel':'')+'" type="button" data-s="'+si+'">'+s.lab.toUpperCase()+'</button>'; }).join('');
        dossier.innerHTML='<div class="cx-dsheet" style="background:'+c.color+'">'
          +'<button class="cx-db-close cx-sheet-close" type="button">Close ✕</button>'
          +'<div class="cx-drow">'
            +'<div class="cx-film-frame"><div class="cx-dv"><video src="'+c.video+'"'+(c.poster?' poster="'+c.poster+'"':'')+' muted loop playsinline preload="metadata"></video><span class="cx-dv-coord">'+c.coord+'</span></div></div>'
            +'<div class="cx-db">'
              +'<p class="cx-db-eyebrow">Conservation coffee &middot; '+c.note+'</p>'
              +'<h3 class="cx-db-name">'+c.name+'</h3>'
              +'<p class="cx-db-desc">'+c.desc+'</p>'
              +'<div class="cx-db-notes">'+c.notes.map(function(n){return '<span class="cx-db-chip">'+n+'</span>';}).join('')+'</div>'
              +(sizes.length?'<div class="cx-db-buy">'
                  +'<div class="cx-price-row">'
                    +'<div class="cx-price"><small class="cx-price-lab">'+sizes[0].lab+'</small>'+cur+' <span class="cx-price-n">'+sizes[0].price+'</span></div>'
                    +'<div class="cx-db-sizes">'+sizePills+'</div>'
                    +'<div class="cx-db-qty"><button class="cx-db-step" type="button" data-d="-1" aria-label="Less">&minus;</button><span class="cx-db-n">1</span><button class="cx-db-step" type="button" data-d="1" aria-label="More">+</button></div>'
                  +'</div>'
                  +'<div class="cx-db-imp2">'
                    +'<span class="cx-db-imp-left">'
                      +'<span class="cx-seal"><svg viewBox="0 0 104 104"><defs><path id="cxSealPath'+i+'" d="M52,52 m-40,0 a40,40 0 1,1 80,0 a40,40 0 1,1 -80,0"/></defs><text><textPath href="#cxSealPath'+i+'" startOffset="0">· 10% OF EVERY BAG · TO THE FOREST </textPath></text></svg><span class="cx-seal-center"><span class="cx-seal-pct">10<small>%</small></span></span></span>'
                      +'<span class="cx-seal-amt"><span class="cx-seal-k">Every bag gives</span><b>'+cur+' <span class="cx-imp-amt">0</span></b><span class="cx-seal-to">to '+c.partner+'</span></span>'
                    +'</span>'
                    +'<button class="cx-db-add" type="button">'+(c.on?'✓ In order · remove':'Add to order →')+'</button>'
                  +'</div>'
                +'</div>':'')
              +'<a class="cx-morelink" href="#">Read the full origin story &rarr;</a>'
            +'</div>'
          +'</div>'
        +'</div>';
        dossier.querySelector('.cx-db-close').addEventListener('click',closeDossier);
        var nEl=dossier.querySelector('.cx-db-n');
        var amtEl=dossier.querySelector('.cx-imp-amt');
        var priceN=dossier.querySelector('.cx-price-n'), priceLab=dossier.querySelector('.cx-price-lab');
        var selSize=0;
        function qtyNow(){ return Math.max(1,parseInt(nEl.textContent,10)||1); }
        function updPrice(){ if(sizes[selSize]){ if(priceN)priceN.textContent=sizes[selSize].price; if(priceLab)priceLab.textContent=sizes[selSize].lab; } }
        function updImpact(animate){ if(amtEl && sizes[selSize]){ var v=sizes[selSize].price*0.10*qtyNow(); if(animate)cxCountUp(amtEl,v,900); else amtEl.textContent=fmtAmt(v); } }
        dossier.querySelectorAll('.cx-db-size').forEach(function(b){
          b.addEventListener('click',function(){ selSize=parseInt(b.getAttribute('data-s'),10);
            dossier.querySelectorAll('.cx-db-size').forEach(function(x){x.classList.remove('is-sel');}); b.classList.add('is-sel'); updPrice(); updImpact(true); });
        });
        dossier.querySelectorAll('.cx-db-step').forEach(function(b){
          b.addEventListener('click',function(){ nEl.textContent=Math.max(1,qtyNow()+parseInt(b.getAttribute('data-d'),10)); updImpact(true); });
        });
        dossier.__revealImpact=function(){ if(amtEl){ amtEl.textContent='0'; updImpact(true); } };
        dossier.querySelector('.cx-db-add').addEventListener('click',function(){
          var btn=dossier.querySelector('.cx-db-add');
          if(togglePick(i)){ btn.textContent=COFFEES[i].on?'✓ In order · remove':'Add to order →'; refreshTiles(); }
          else flashKeep(btn,function(){ btn.textContent='✓ In order · remove'; });
        });
      }
      // Two-beat: the compact detail card (already wedged in via the carousel) DROPS DOWN then WIDENS
      // into the full dossier. Only a solid colour block travels; the video + text reveal once it lands.
      function openDossier(i){
        if(!dossier) return;
        var c=COFFEES[i];
        var inlineCard = cells[cells.length-1].el.querySelector('.cx-detailcard');
        var f = inlineCard ? inlineCard.getBoundingClientRect() : cells[i].el.getBoundingClientRect();
        buildDossier(c,i);
        dossierIdx=i;
        dossier.style.maxWidth='none';
        dossier.style.borderRadius='0';
        dossier.style.width='min(1240px,94vw)'; dossier.style.marginLeft='auto'; dossier.style.marginRight='auto';
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        dossier.classList.add('is-open','is-flying','is-morphing');
        dossier.setAttribute('aria-hidden','false');
        dossier.style.transition='none'; dossier.style.maxHeight=dossier.scrollHeight+'px'; void dossier.offsetWidth;
        var sheetEl = dossier.querySelector('.cx-dsheet');
        var l = (sheetEl||dossier).getBoundingClientRect();
        var vid = dossier.querySelector('video');
        var m=ensureMorph();
        m.style.display='block'; m.style.background=c.color; m.style.borderRadius='16px';
        m.style.left=f.left+'px'; m.style.top=f.top+'px'; m.style.width=f.width+'px'; m.style.height=f.height+'px';
        m.style.transition='none'; m.style.opacity='1'; m.innerHTML='';
        var clone=null;
        if(inlineCard){ clone=inlineCard.cloneNode(true); clone.style.background='transparent'; clone.style.height='100%'; clone.style.transition='opacity .16s ease'; m.appendChild(clone); }
        void m.offsetWidth;
        closeDetail();                        // the two coffees slide back together as the card leaves
        if(inlineCard){ inlineCard.style.transition='opacity .1s ease'; inlineCard.style.opacity='0'; }
        if(reduce){ dossier.classList.remove('is-flying','is-morphing'); m.style.display='none'; m.innerHTML=''; dossier.style.transition=''; if(dossier.__revealImpact) dossier.__revealImpact(); if(vid&&vid.play)vid.play().catch(function(){}); try{ window.scrollTo({top:Math.max(0,dossier.getBoundingClientRect().top+window.scrollY-100),behavior:'smooth'}); }catch(e){} return; }
        var expanded=false, finished=false;
        var landed=function(){
          if(finished) return; finished=true;
          m.removeEventListener('transitionend',onEnd); clearTimeout(morphT);
          m.style.display='none'; m.style.opacity='0'; m.innerHTML='';
          if(dossierIdx!==i) return;
          dossier.classList.remove('is-flying');
          dossier.classList.remove('is-morphing');
          dossier.style.transition='';
          if(dossier.__revealImpact) dossier.__revealImpact();
          if(vid&&vid.play){var p=vid.play();if(p&&p.catch)p.catch(function(){});}
          setTimeout(function(){ if(dossierIdx!==i) return; try{ window.scrollTo({top:Math.max(0,dossier.getBoundingClientRect().top+window.scrollY-100),behavior:'smooth'}); }catch(e){} }, 260);
        };
        var expand=function(){
          if(expanded) return; expanded=true;
          if(clone) clone.style.opacity='0';
          setTimeout(function(){
            m.style.transition='left .52s cubic-bezier(.4,0,.15,1), width .52s cubic-bezier(.4,0,.15,1), height .52s cubic-bezier(.4,0,.15,1), border-radius .52s ease';
            m.style.left=l.left+'px'; m.style.width=l.width+'px'; m.style.height=l.height+'px'; m.style.borderRadius='18px';
          }, 150);
        };
        var onEnd=function(e){
          if(e.propertyName==='top' && !expanded){ expand(); }
          else if(expanded && (e.propertyName==='width'||e.propertyName==='height')){ landed(); }
        };
        m.addEventListener('transitionend',onEnd);
        requestAnimationFrame(function(){ requestAnimationFrame(function(){
          m.style.transition='top .38s cubic-bezier(.45,0,.35,1)';
          m.style.top=l.top+'px';
        }); });
        clearTimeout(morphT); morphT=setTimeout(function(){ if(!expanded)expand(); setTimeout(landed,760); }, 1800);
      }
      function closeDossier(){
        if(dossierIdx<0 || !dossier) return;
        clearTimeout(morphT);
        if(morph){ morph.style.display='none'; morph.style.opacity='0'; }
        var vid=dossier.querySelector('video'); if(vid){ try{vid.pause();}catch(e){} }
        dossier.classList.remove('is-flying','is-morphing');
        dossier.style.transition='max-height .45s cubic-bezier(.4,0,.2,1)';
        dossier.style.maxHeight='0px';
        dossier.classList.remove('is-open');
        dossier.setAttribute('aria-hidden','true');
        dossierIdx=-1; refreshTiles();
        try{ window.scrollTo({top:Math.max(0,vp.getBoundingClientRect().top+window.scrollY-100),behavior:'smooth'}); }catch(e){}
      }

      window.__pickedOrigins = function(){
        return COFFEES.filter(function(c){return c.on;}).map(function(c){ return {name:c.name, sched:c.sched}; });
      };
      window.addEventListener('resize',function(){ layout(false); syncDossierHeight(); });
      if('ResizeObserver' in window){ new ResizeObserver(function(){ layout(false); syncDossierHeight(); }).observe(vp); }
      document.addEventListener('keydown',function(e){ if(e.key==='Escape'){ if(openIdx>=0) closeDetail(); if(dossierIdx>=0) closeDossier(); } });
      build(); refreshHint();
      requestAnimationFrame(function(){ layout(false); });
    })();
</script>
<!-- ═══ end coffee-picker partial ═══ -->
