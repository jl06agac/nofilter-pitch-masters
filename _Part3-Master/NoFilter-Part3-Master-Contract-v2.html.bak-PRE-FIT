<div class="relief__body">
<h2 class="schedule__title">Six services.<br/>Bi-annual.<br/>Across the term.</h2>
<div class="schedule__sub" id="ct-serv-range">01 JUN 2026 — 01 JUN 2029 · PER CL. 03</div>
<div class="lots">
<div class="lots__head lots__head--2col">
<div>Service</div>
<div>Scheduled date</div>
</div>
<div class="lots__row lots__row--2col ct-serv-row" data-sv-row="1">
<div class="lot">SV-01</div>
<div class="origin" data-sv="1">01 December 2026</div>
</div>
<div class="lots__row lots__row--2col ct-serv-row" data-sv-row="2">
<div class="lot">SV-02</div>
<div class="origin" data-sv="2">01 June 2027</div>
</div>
<div class="lots__row lots__row--2col ct-serv-row" data-sv-row="3">
<div class="lot">SV-03</div>
<div class="origin" data-sv="3">01 December 2027</div>
</div>
<div class="lots__row lots__row--2col ct-serv-row" data-sv-row="4">
<div class="lot">SV-04</div>
<div class="origin" data-sv="4">01 June 2028</div>
</div>
<div class="lots__row lots__row--2col ct-serv-row" data-sv-row="5">
<div class="lot">SV-05</div>
<div class="origin" data-sv="5">01 December 2028</div>
</div>
<div class="lots__row lots__row--2col ct-serv-row" data-sv-row="6">
<div class="lot">SV-06</div>
<div class="origin" data-sv="6">01 June 2029</div>
</div>
</div>
<div class="totals">
<div class="note">
          Six (6) bi-annual preventative maintenance and calibration visits, scheduled at six-month intervals from the installation target of 01 June 2026. The Supplier may reschedule any visit by mutual agreement with the Customer with no less than five (5) business days' notice.
        </div>
</div>
</div>
</div>
<div class="rail rail--bottom">
<div class="rail__group"><span>WORKPLACE COFFEE AGREEMENT</span></div>
<div class="rail__group"><span class="orange">PAGE</span><span>09 / 09</span></div>
</div>
</section>
<script id="nf-contract-sync">
/* ===================================================================
   CONTRACT SYNC (File 2) — reads Part 2's handed-over selections from
   localStorage ('nf-part2-selections') and populates the contract cells.
   Ported from the Part 3 configurator's syncContract(); step 1 swapped
   from live-wizard-DOM reads to a localStorage read. Steps 2–6 (DOM
   writes, term/date math, servicing rows) unchanged. Existence-guarded
   throughout, so a direct open with no handoff leaves the build-time tokens intact.
   =================================================================== */
(function () {
  var CT_MONTHS = ['January','February','March','April','May','June',
                   'July','August','September','October','November','December'];
  var CT_MONTHS_SHORT = ['Jan','Feb','Mar','Apr','May','Jun',
                         'Jul','Aug','Sep','Oct','Nov','Dec'];
  function ctAddMonths(d, n) {
    var r = new Date(d.getTime());
    var day = r.getDate();
    r.setDate(1);
    r.setMonth(r.getMonth() + n);
    /* clamp to month end if the original day overflows */
    var dim = new Date(r.getFullYear(), r.getMonth() + 1, 0).getDate();
    r.setDate(Math.min(day, dim));
    return r;
  }
  function ctFormatLong(d) {
    return ('0' + d.getDate()).slice(-2) + ' ' + CT_MONTHS[d.getMonth()] + ' ' + d.getFullYear();
  }
  function ctFormatShortUpper(d) {
    return ('0' + d.getDate()).slice(-2) + ' ' + CT_MONTHS_SHORT[d.getMonth()].toUpperCase() + ' ' + d.getFullYear();
  }
  /* parse "01 June 2026" or "01 Jun 2026"; returns null on anything else
     (incl. an unbuilt term-start token). */
  function ctParseDate(txt) {
    if (!txt) return null;
    var m = String(txt).trim().match(/(\d{1,2})\s+([A-Za-z]+)\s+(\d{4})/);
    if (!m) return null;
    var day = parseInt(m[1], 10);
    var monName = m[2].toLowerCase();
    var year = parseInt(m[3], 10);
    var idx = -1;
    for (var i = 0; i < CT_MONTHS.length; i++) {
      if (CT_MONTHS[i].toLowerCase() === monName ||
          CT_MONTHS_SHORT[i].toLowerCase() === monName) { idx = i; break; }
    }
    if (idx < 0) return null;
    return new Date(year, idx, day);
  }
  function ctSetText(el, txt) { if (el) el.textContent = txt; }
  function ctSetTextAll(sel, txt) {
    document.querySelectorAll(sel).forEach(function (el) { el.textContent = txt; });
  }

  function syncContract() {
    /* ---- 1. read the selections handed over from Part 2 via localStorage ---- */
    var SEL = null;
    try {
      var raw = localStorage.getItem('nf-part2-selections');
      if (raw) SEL = JSON.parse(raw);
    } catch (e) { SEL = null; }
    if (!SEL) { return; }  /* opened directly / no handoff yet — leave tokens as-is */

    /* ---- schema guard: this endpoint reads Part 2's v2 ("fleet") shape only.
       A v1 (single-machine wizard) payload has no fleet[] and must be ignored so
       we never half-populate the contract from an incompatible handoff. ---- */
    if (SEL.v !== 2) { return; }

    /* ---- v2 fleet: [{machine, qty, mode, termMonths}]; termMonths null if purchase ---- */
    var fleet = Array.isArray(SEL.fleet) ? SEL.fleet.filter(function (m) {
      return m && (m.qty == null || Number(m.qty) > 0);
    }) : [];
    var primary = fleet.length ? fleet[0] : null;

    /* Derive a term-in-months for the contract's Schedule A / term math from the
       primary machine. Rentals carry termMonths; purchases have none. */
    var primaryTermMonths = (primary && primary.termMonths != null)
      ? parseInt(primary.termMonths, 10) : null;

    /* Build the equipment-summary line the donor previously read from equipSummary,
       now derived from fleet[] (e.g. "CafeMatic 5 — 36-month rental"). */
    function fleetLine(m) {
      var name = m.machine || 'Equipment';
      var qtyN = (m.qty != null) ? Number(m.qty) : 1;
      var qtyStr = (qtyN > 1) ? (' x ' + qtyN) : '';
      var termStr = (m.mode === 'rental' && m.termMonths != null)
        ? (parseInt(m.termMonths, 10) + '-month rental')
        : (m.mode === 'purchase' ? 'purchase'
           : (m.termMonths != null ? (parseInt(m.termMonths, 10) + '-month rental') : 'purchase'));
      return name + qtyStr + ' — ' + termStr;
    }
    var equipSummary = fleet.map(fleetLine).join(' · ');

    /* ---- 2. machine name + equipment summary (Schedule A) ---- */
    ctSetText(document.getElementById('ct-equip-summary'), equipSummary);

    if (fleet.length === 1) {
      /* single machine: fill the single Schedule A machine slot the donor did */
      ctSetText(document.getElementById('ct-schedA-machine'), primary.machine || '');
    } else if (fleet.length > 1) {
      /* multiple machines: summarise all of them into the primary machine slot,
         one line per machine (name x qty — N-month rental / purchase) */
      var mEl = document.getElementById('ct-schedA-machine');
      if (mEl) {
        mEl.innerHTML = fleet.map(function (m) {
          var esc = String(fleetLine(m))
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          return esc;
        }).join('<br/>');
      }
    }

    /* Schedule A monthly rate: v2 carries a formatted fleet monthly total
       (fleetMonthly) rather than a per-machine rate. Populate the rate + band
       cells from it when present; otherwise fall back to "on application". */
    var fm = (SEL.fleetMonthly != null && String(SEL.fleetMonthly).trim() !== '')
      ? String(SEL.fleetMonthly).trim() : null;
    if (fm != null) {
      ctSetText(document.getElementById('ct-schedA-rate'), fm);
      ctSetText(document.getElementById('ct-schedA-rate-band'), '$ ' + fm);
      var noteEl = document.getElementById('ct-schedA-note-rate');
      if (noteEl) {
        noteEl.innerHTML =
          'The monthly rate is fixed at $' + fm +
          ' for the term. Daily cleaning materials and consumables are billed separately under <b>Schedule B</b>.';
      }
    } else {
      ctSetText(document.getElementById('ct-schedA-rate'), '— (on application)');
      ctSetText(document.getElementById('ct-schedA-rate-band'), '— (on application)');
    }

    /* ---- 2b. Conservation rate + optional Top-Up (v2 conservationRate is a
       display string like "5%" / "10%"). There is no v1 source to convert; the
       donor's coreRate/rate/indicative drove the machine rental rate, not this.
       Reveal the elected-rate sentence in the Conservation Contribution clause. ---- */
    var consRate = (SEL.conservationRate != null && String(SEL.conservationRate).trim() !== '')
      ? String(SEL.conservationRate).trim() : null;
    if (consRate != null) {
      ctSetText(document.getElementById('ct-cons-rate'), consRate);
      var consWrap = document.querySelector('.ct-cons-elected');
      if (consWrap) consWrap.style.display = '';
      var topUpN = (SEL.topUp != null) ? Number(SEL.topUp) : null;
      var topUpWrap = document.querySelector('.ct-topup-wrap');
      if (topUpN != null && !isNaN(topUpN) && topUpN > 0) {
        ctSetText(document.getElementById('ct-topup'), '$' + topUpN.toFixed(2));
        if (topUpWrap) topUpWrap.style.display = '';
      } else if (topUpWrap) {
        topUpWrap.style.display = 'none';
      }
    }

    /* ---- 3. term start date from the rendered contract text ---- */
    var startEl = document.querySelector('.ct-term-start');
    var start = startEl ? ctParseDate(startEl.textContent) : null;

    if (start && primaryTermMonths != null && primaryTermMonths > 0) {
      var months = primaryTermMonths;
      var end = ctAddMonths(start, months);

      /* term spans + ranges */
      ctSetTextAll('.ct-term-start', ctFormatLong(start));
      ctSetTextAll('.ct-term-end', ctFormatLong(end));
      ctSetTextAll('.ct-term-months', String(months));
      ctSetTextAll('.ct-term-months-cell', months + ' months');
      ctSetText(document.getElementById('ct-term-range'),
                ctFormatLong(start) + ' — ' + ctFormatLong(end));
      ctSetText(document.getElementById('ct-serv-range'),
                ctFormatShortUpper(start) + ' — ' + ctFormatShortUpper(end) + ' · PER CL. 03');

      /* ---- 5. service visits: n = start + 6*n months, n = 1..(months/6) ---- */
      var visits = Math.floor(months / 6);
      for (var n = 1; n <= 6; n++) {
        var cell = document.querySelector('[data-sv="' + n + '"]');
        var row = document.querySelector('[data-sv-row="' + n + '"]');
        if (n <= visits) {
          if (cell) cell.textContent = ctFormatLong(ctAddMonths(start, 6 * n));
          if (row) row.style.display = '';
        } else {
          if (row) row.style.display = 'none';
        }
      }
    }

    /* ---- 6. Schedule B: filter coffee lots to the client's selected origins
       and set their unit price to the live coffee price. Consumable rows carry
       no data-origin-row and are left untouched. Before any pick, show all four.
       Origins are matched on canonical name OR sched (master emits e.g.
       {name:"Arakan", sched:"arakan"} while the row is "Arakan Mountains"). ---- */
    try {
      var cp = (SEL.coffeePrice != null) ? Number(SEL.coffeePrice) : null;
      /* canonical key set from each picked origin: lowercased name + sched */
      var pickedKeys = {};
      if (Array.isArray(SEL.origins)) {
        SEL.origins.forEach(function (o) {
          if (!o) return;
          if (typeof o === 'string') { pickedKeys[o.toLowerCase()] = true; return; }
          if (o.name) pickedKeys[String(o.name).toLowerCase()] = true;
          if (o.sched) pickedKeys[String(o.sched).toLowerCase()] = true;
        });
      }
      function rowIsPicked(rowName) {
        var rn = String(rowName || '').toLowerCase();
        if (pickedKeys[rn]) return true;
        /* prefix/contains match so "Arakan" picks "Arakan Mountains" and vice versa */
        for (var k in pickedKeys) {
          if (!pickedKeys.hasOwnProperty(k)) continue;
          if (rn.indexOf(k) === 0 || k.indexOf(rn) === 0) return true;
        }
        return false;
      }
      var anyPicked = Object.keys(pickedKeys).length > 0;
      document.querySelectorAll('.lots__row[data-origin-row]').forEach(function (row) {
        var name = row.getAttribute('data-origin-row');
        var show = anyPicked ? rowIsPicked(name) : true;
        row.style.display = show ? '' : 'none';
        if (show && cp != null && !isNaN(cp)) {
          var pr = row.querySelector('.price');
          if (pr) pr.textContent = cp.toFixed(2);
        }
      });
    } catch (e) { /* no-op */ }
  }

  window.__nfSyncContract = syncContract;
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () {
      try { syncContract(); } catch (e) { console.warn('syncContract', e); }
    });
  } else {
    try { syncContract(); } catch (e) { console.warn('syncContract', e); }
  }
  window.addEventListener('beforeprint', function () {
    try { syncContract(); } catch (e) { /* no-op */ }
  });
})();
</script>
</body></html>
